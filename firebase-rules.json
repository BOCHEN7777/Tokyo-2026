{
  "rules": {
    "allowedUsers": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false,
        ".validate": "newData.val() === true"
      }
    },
    "trips": {
      "$room": {
        "members": {
          ".read": "auth != null && root.child('allowedUsers').child(auth.uid).val() === true",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('allowedUsers').child(auth.uid).val() === true && newData.exists()",
            ".validate": "newData.hasChildren(['name', 'online', 'updatedAt'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20"
            },
            "online": {
              ".validate": "newData.isBoolean()"
            },
            "updatedAt": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "state": {
          ".read": "auth != null && root.child('allowedUsers').child(auth.uid).val() === true",
          ".write": "auth != null && root.child('allowedUsers').child(auth.uid).val() === true && newData.exists()",
          ".validate": "newData.hasChildren(['schema', 'updatedAt', 'updatedBy', 'updatedByUid', 'updatedByName', 'data'])",
          "schema": {
            ".validate": "newData.val() === 2"
          },
          "updatedAt": {
            ".validate": "newData.isNumber()"
          },
          "updatedBy": {
            ".validate": "newData.isString()"
          },
          "updatedByUid": {
            ".validate": "newData.val() === auth.uid"
          },
          "updatedByName": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20"
          },
          "data": {
            ".validate": "newData.hasChildren()"
          },
          "$other": {
            ".validate": false
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
