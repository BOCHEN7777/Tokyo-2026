{
  "rules": {
    "allowedUsers": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false,
        ".validate": "newData.val() === true"
      }
    },
    "trips": {
      "$room": {
        "members": {
          ".read": "auth != null && root.child('allowedUsers').child(auth.uid).val() === true",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('allowedUsers').child(auth.uid).val() === true && newData.exists()",
            ".validate": "newData.hasChildren(['name', 'online', 'updatedAt'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20"
            },
            "online": {
              ".validate": "newData.isBoolean()"
            },
            "updatedAt": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "state": {
          ".read": "auth != null && root.child('allowedUsers').child(auth.uid).val() === true",
          ".write": "auth != null && root.child('allowedUsers').child(auth.uid).val() === true && newData.exists()",
          ".validate": "newData.hasChildren(['schema', 'updatedAt', 'updatedBy', 'updatedByUid', 'updatedByName', 'data'])",
          "schema": {
            ".validate": "newData.val() === 2"
          },
          "updatedAt": {
            ".validate": "newData.isNumber()"
          },
          "updatedBy": {
            ".validate": "newData.isString()"
          },
          "updatedByUid": {
            ".validate": "newData.val() === auth.uid"
          },
          "updatedByName": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20"
          },
          "data": {
            ".validate": "newData.hasChildren()"
          },
          "$other": {
            ".validate": false
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "publicLedger": {
      ".read": true,
      "expenses": {
        "$expenseId": {
          ".write": "!data.exists() && newData.exists() && $expenseId.matches(/^[A-Za-z0-9_-]{1,100}$/)",
          ".validate": "newData.hasChildren(['id','date','owner','category','item','note','amount','currency','createdAt']) && newData.numChildren() === 9",
          "id": {
            ".validate": "newData.isString() && newData.val() === $expenseId"
          },
          "date": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
          },
          "owner": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
          },
          "category": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
          },
          "item": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200"
          },
          "note": {
            ".validate": "newData.isString() && newData.val().length <= 2000"
          },
          "amount": {
            ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 100000000"
          },
          "currency": {
            ".validate": "newData.isString() && (newData.val() === 'JPY' || newData.val() === 'CNY')"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && newData.val() > 0"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "$other": {
        ".validate": false
      }
    },
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
